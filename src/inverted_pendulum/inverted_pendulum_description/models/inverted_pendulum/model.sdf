<sdf version="1.8">
  <model name="inverted_pendulum">
    <link name="cart">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      <visual name="visual_cart">
        <geometry>
          <box>
            <size>1 0.5 0.2</size>
          </box>
        </geometry>
      </visual>
      <collision name="collision_cart">
        <geometry>
          <box>
            <size>1 0.5 0.2</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="pendulum">
      <pose>0 0 1 0 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
        </inertia>
      </inertial>
      <visual name="visual_pendulum">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>1</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision_pendulum">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>1</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="pendulum_joint" type="revolute">
      <parent>cart</parent>
      <child>pendulum</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
        </limit>
      </axis>
    </joint>

    <plugin filename="your_control_plugin" name="your::control::Plugin"/>
  </model>
</sdf>